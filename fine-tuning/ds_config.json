{
    "fp16": {
        "enabled": true
    },
    "zero_optimization": {
        "stage": 1,
        "reduce_scatter": true,
        "contiguous_gradients": true,
        "overlap_comm": true,
        "offload_param": {
            "device": "cpu",
            "pin_memory": true
        },
        "offload_optimizer": {
            "device": "cpu",
            "pin_memory": true
        },

        "sub_group_size": 1e9
    },
    "optimizer": {
        "type": "AdamW",
        "params": {
            "lr": 3e-6,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-8
        }
    },
    "scheduler": {
        "type": "WarmupLR",
        "params": {
            "warmup_min_lr": 0,
            "warmup_max_lr": 3e-6,
            "warmup_num_steps": "auto"
        }
    },
    "train_micro_batch_size_per_gpu": 2,
    "gradient_accumulation_steps": 16,
    "train_batch_size": 32
}